# ---------------------------------------------------------------------------
# bash build artifacts.  None of these are part of a pristine bash tarball;
# they are produced by ./configure + make.  Keeping them out means a checkout
# is exactly "upstream source + the Android port changes".
# ---------------------------------------------------------------------------
