*.a
*.so
*.so.*
*.lo
*.la
*.deps
.libs/
*.gmo
*.mo
y.tab.c
y.tab.h
config.h
config.log
config.status
config.cache
pathnames.h
buildconf.h
Makefile
stamp-h
stamp-h.in
bash
bashbug
bashversion
buildversion
mkbuiltins
mksignatures
mksyntax
gen-helpfiles
pcomplib
recho
zecho
printenv
xcase
autom4te.cache/
builtins/builtext.h
examples/loadables/*.so

